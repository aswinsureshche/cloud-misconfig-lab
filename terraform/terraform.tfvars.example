# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit it (see ../.gitignore).

aws_region       = "us-east-1"
project_name     = "cloud-misconfig-lab"
alert_email      = "you@example.com"     # required: receives the AWS Budget alert
budget_limit_usd = 5

# Find your own public IP with: curl -s ifconfig.me
# Only used once you apply with -var="harden=true"
trusted_cidr = "203.0.113.4/32"

# Leave this alone here — override on the command line instead:
#   terraform apply                      (harden=false, the vulnerable state)
#   terraform apply -var="harden=true"   (the hardened state)
harden = false
